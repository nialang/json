// The benchmark harness: parses, reuses, writes, or round-trips the document
// on standard input a given number of times and reports what it did and how
// long the measured loop took. `tools/bench.py` drives it, and the comparators
// in `bench/` print the same report.
//
//     bench <parse|reuse|write|roundtrip|read|load> <iterations> < input.json
//
// `read` only reads the input, and `load` also parses it once and keeps the
// document until the process exits: the difference of their peak resident
// memory is what the document costs.
//
// Exit status 2 means bad arguments or input, 3 a failed parse, 4 a failed
// write, and 5 a failed release.

using std::io;
using std::mem;
using std::option;
using std::process;
using std::slice;
using std::time;
using json;

// What each iteration of the measured loop does.
enum Mode {
    // Parses into a fresh document and releases it.
    Parse,
    // Parses into one document whose storage is reused.
    Reuse,
    // Writes the document parsed before the loop.
    Write,
    // Parses into a fresh document, writes it, and releases it.
    Roundtrip,
    // Reads the input and nothing else.
    Read,
    // Parses the input once and keeps the document.
    Load,
}

fun parseMode(name: &[u8]) ?Mode {
    if name.equals(b"parse") {
        return ?.Parse;
    }
    if name.equals(b"reuse") {
        return ?.Reuse;
    }
    if name.equals(b"write") {
        return ?.Write;
    }
    if name.equals(b"roundtrip") {
        return ?.Roundtrip;
    }
    if name.equals(b"read") {
        return ?.Read;
    }
    if name.equals(b"load") {
        return ?.Load;
    }
    null
}

pub fun main(init: process::Init) process::ExitCode!() {
    let args = init.args();
    if args.len() != 3 {
        return process::ExitCode(2)!;
    }
    let modeName = args.get(1).okOr(process::ExitCode(2)).?.bytes();
    let mode = parseMode(modeName).okOr(process::ExitCode(2)).?;
    let iterations = match args.get(2) {
        ?arg => match arg.parse[usize]() {
            !value => value,
            _! => return process::ExitCode(2)!,
        },
        null => return process::ExitCode(2)!,
    };
    if iterations == 0 {
        return process::ExitCode(2)!;
    }

    let mut page: mem::PageAllocator = .init();
    let mut allocator: mem::GeneralPurposeAllocator = .init(page);
    defer allocator.deinit().?;
    let mut input: std::ArrayList[u8] = .init();
    defer input.deinit(allocator).?;
    let mut readBuffer: [u8; 4096] = [0; 4096];
    let mut reader = io::FileReader::stdin(readBuffer);
    // The default limits, except that the document may hold as many values
    // as its input can: other libraries limit neither, and the corpora for
    // memory hold millions of values.
    let defaults = json::Options::init();
    let options = defaults.withMaxNodes(defaults.maxInputBytes() / 2 + 2);
    let maxInput = options.maxInputBytes();
    if io::readToEnd(&mut reader, allocator, maxInput, &mut input) is error! {
        return process::ExitCode(2)!;
    }

    if mode == .Read {
        io::debugPrint(
            "iterations=0 nodes=0 input_bytes={} output_bytes=0 elapsed_ns=1\n",
            [input.len()],
        ).?;
        return !();
    }

    let mut document = json::Document::init();
    defer document.deinit(allocator).?;
    if mode == .Load {
        let start = time::Instant::now();
        if document.parseWith(allocator, input.asSlice(), options) is error! {
            return process::ExitCode(3)!;
        }
        let elapsed = start.elapsed();
        io::debugPrint(
            "iterations=1 nodes={} input_bytes={} output_bytes=0 elapsed_ns={}\n",
            [document.nodeCount(), input.len(), elapsed.nanos()],
        ).?;
        return !();
    }
    let mut totalNodes: usize = 0;
    let mut outputBytes: usize = 0;
    // Text is written into memory, as the comparators write it: a buffer
    // sized once from a first, untimed write and reused by every iteration.
    let mut sizing = io::DiscardingWriter::init();
    if document.parseWith(allocator, input.asSlice(), options) is error! {
        return process::ExitCode(3)!;
    }
    let first = document.value().okOr(process::ExitCode(3)).?;
    if first.writeTo(&mut sizing, json::WriteOptions::compact()) is error! {
        return process::ExitCode(4)!;
    }
    let mut text = allocator.allocSlice[u8](sizing.len()).?;
    defer text.deinit(allocator).?;
    if mode != .Write {
        if document.deinit(allocator) is error! {
            return process::ExitCode(5)!;
        }
        document = json::Document::init();
    }

    // Only the measured loop is timed: reading stdin, the warm document for
    // writing and process startup are not part of a sample.
    let start = time::Instant::now();
    for _ in 0..iterations {
        if mode != .Write {
            if document.parseWith(allocator, input.asSlice(), options) is error! {
                return process::ExitCode(3)!;
            }
        }
        totalNodes += document.nodeCount();
        if mode == .Write or mode == .Roundtrip {
            let value = document.value().okOr(process::ExitCode(3)).?;
            let mut output = io::FixedBufferWriter::init(text.asMutSlice());
            if value.writeTo(&mut output, json::WriteOptions::compact()) is error! {
                return process::ExitCode(4)!;
            }
            outputBytes += output.len();
        }
        if mode == .Parse or mode == .Roundtrip {
            if document.deinit(allocator) is error! {
                return process::ExitCode(5)!;
            }
            document = json::Document::init();
        }
    }
    let elapsed = start.elapsed();

    io::debugPrint(
        "iterations={} nodes={} input_bytes={} output_bytes={} elapsed_ns={}\n",
        [iterations, totalNodes, input.len(), outputBytes, elapsed.nanos()],
    ).?;
    !()
}
